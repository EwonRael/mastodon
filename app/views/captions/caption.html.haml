!!! 5
%html
  %head
    %meta{ charset: 'utf-8' }/
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }/
    %title Write a caption
    %meta{ property: 'og:image', content: "https://#{Rails.configuration.x.web_domain}/caption-og-image.jpg" }/
    :css
      body { font-family: sans-serif; max-width: 40em; margin: 2em auto; padding: 0 1em; }
      img { width: 100%; height: auto; display: block; margin-bottom: 1em; box-sizing: border-box; }
      textarea { width: 100%; font: inherit; box-sizing: border-box; margin-top: 0.5em; }
      .button-row { overflow: auto; margin-top: 0.5em; }
      .submit-caption { float: right; }
  %body
    = yield
